## Reverse an array
#include<stdio.h>
void reverse(int *arr,int n)
{
     for(int i;i<n/2;i++)
    {
        int temp=arr[i];
        arr[i]=arr[n-i-1];
        arr[n-i-1]=temp;
    }
}
