## semaphore 
#include<stdio.h>
#include<pthread.h>
#include<semaphore.h>
#define MAX 10
pthread_mutex_t lock;

sem_t sem_even;
sem_t sem_odd;
int counter=1;

void *thread1(void *argv)
{
    while(1)
    {
        sem_wait(&sem_even);
        if(counter >= MAX)
        {
            sem_post(&sem_odd);
            break;
        }
        if(counter %2 ==0)
        {
            printf("%d ",counter);
            counter++;
        }
        sem_post(&sem_odd);
    }
    return NULL;
}

void *thread2(void *argv)
{
    while(1)
    {
        sem_wait(&sem_odd);
        if(counter>=MAX)
        {
            sem_post(&sem_even);
            break;
        }
        if(counter%2 ==1)
        {
            printf("%d ",counter);
            counter++;
        }
        sem_post(&sem_even);
    }
    return NULL;
}

int main()
{
    pthread_t t1,t2;
    
    sem_init(&sem_even,0,1);
    sem_init(&sem_odd,0,0);
    pthread_mutex_init(&lock,NULL);
    
    pthread_create(&t1,NULL,thread1,NULL);
    pthread_create(&t2,NULL,thread2,NULL);
    
    pthread_join(t1,NULL);
    pthread_join(t2,NULL);
}
##mutex
#include<stdio.h>
#include<pthread.h>
#define MAX 10
pthread_mutex_t lock;
int counter=1;

void *thread1(void *argv)
{
    while(1)
    {
        pthread_mutex_lock(&lock);
        if(counter >= MAX)
        {
            pthread_mutex_unlock(&lock);
            break;
        }
        if(counter %2 ==0)
        {
            printf("%d ",counter);
            counter++;
        }
        pthread_mutex_unlock(&lock);
    }
    return NULL;
}

void *thread2(void *argv)
{
    while(1)
    {
        pthread_mutex_lock(&lock);
        if(counter>=MAX)
        {
            pthread_mutex_unlock(&lock);
            break;
        }
        if(counter%2 ==1)
        {
            printf("%d ",counter);
            counter++;
        }
        pthread_mutex_unlock(&lock);
    }
    return NULL;
}

int main()
{
    pthread_t t1,t2;
    
    pthread_mutex_init(&lock,NULL);
    
    pthread_create(&t1,NULL,thread1,NULL);
    pthread_create(&t2,NULL,thread2,NULL);
    
    pthread_join(t1,NULL);
    pthread_join(t2,NULL);
}
