int insert(int *arr,int n)
{
    int pos=3;
    int val=4;
    for(int i=0;i<=n;i++)
    {
        if(arr[i]==val)
        {
            for(int j=i;j<n;j++)
            {
                arr[j]=arr[j+1];
            }
            n--;
