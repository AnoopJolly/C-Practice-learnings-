## Reverse an array
#include<stdio.h>
void reverse(int *arr,int n)
{
     for(int i;i<n/2;i++)
    {
        int temp=arr[i];
        arr[i]=arr[n-i-1];
        arr[n-i-1]=temp;
    }
}
int main()
{
    int arr[]={1,2,3,4,5};
    int n=sizeof(arr)/sizeof(arr[0]);
    
    reverse(arr,n);
    
    for(int i=0;i<n;i++)
    printf("%d",arr[i]);
